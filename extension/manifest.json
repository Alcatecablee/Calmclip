{
  "manifest_version": 3,
  "name": "CalmClip: Send to Editor",
  "short_name": "CalmClip",
  "version": "0.1.0",
  "description": "Right-click any video or audio on the web and open it in CalmClip for local editing. No uploads, no servers.",
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "*://drive.google.com/*",
    "*://drive.usercontent.google.com/*",
    "*://*.dropbox.com/*",
    "*://*.dropboxusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://drive.google.com/file/d/*"],
      "js": ["content/drive.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.dropbox.com/s/*", "*://*.dropbox.com/scl/fi/*"],
      "js": ["content/dropbox.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://localhost/*",
        "*://calmclip.video/*",
        "*://*.calmclip.video/*"
      ],
      "js": ["content/receiver.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
