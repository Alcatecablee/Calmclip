{
  "name": "CalmClip - Privacy Video Editor",
  "short_name": "CalmClip",
  "description": "Trim, caption, and export video in your browser. Zero uploads. 100% local processing with WebAssembly. No account, no install.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "id": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f0f11",
  "theme_color": "#363640",
  "categories": ["productivity", "utilities", "video"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "handle_links": "preferred",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Edit a video",
      "short_name": "New edit",
      "description": "Open CalmClip and drop a video to start editing immediately",
      "url": "/?source=shortcut-edit",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "video/mp4":        [".mp4"],
        "video/webm":       [".webm"],
        "video/quicktime":  [".mov"],
        "video/x-matroska": [".mkv"],
        "video/x-msvideo":  [".avi"]
      }
    }
  ],
  "share_target": {
    "action": "/?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "video",
          "accept": ["video/mp4", "video/webm", "video/quicktime", "video/x-matroska"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+calmclip",
      "url": "/?protocol=%s"
    }
  ]
}
